diff --git a/src/libcharon/sa/ikev2/tasks/ike_init.c b/src/libcharon/sa/ikev2/tasks/ike_init.c
index 44a89f9..a7ad679 100644
--- a/src/libcharon/sa/ikev2/tasks/ike_init.c
+++ b/src/libcharon/sa/ikev2/tasks/ike_init.c
@@ -481,6 +481,22 @@ static bool build_payloads(private_ike_init_t *this, message_t *message)
 								chunk_empty);
 		}
 	}
+	/* FortiGate: FortiClient sends the "network ID" of the dial-up tunnel as
+	 * proprietary notify VPN_NETWORK_ID (61520, one byte) in IKE_SA_INIT. A
+	 * gateway with several IKEv2 dial-up tunnels on one interface selects the
+	 * tunnel by it and answers NO_PROPOSAL_CHOSEN without it. */
+	if (!this->old_sa && this->initiator)
+	{
+		int network_id = lib->settings->get_int(lib->settings,
+							"%s.fortigate_network_id", -1, lib->ns);
+		if (network_id >= 0 && network_id <= 255)
+		{
+			uint8_t id = network_id;
+
+			message->add_notify(message, FALSE, (notify_type_t)61520,
+								chunk_from_thing(id));
+		}
+	}
 	return TRUE;
 }
 
